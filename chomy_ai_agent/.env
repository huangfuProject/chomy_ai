
# Nacos 连接配置
NACOS_SERVER_ADDRESS=192.168.3.103:8848
NACOS_NAMESPACE_ID=34a480c0-e54d-47f5-9524-726dfe7d82b8
NACOS_CONFIG_DATA_ID=chomy_ai_agent
NACOS_CONFIG_GROUP=DEFAULT_GROUP
# Nacos 鉴权配置
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# SDK 日志和缓存目录
NACOS_LOG_LEVEL=INFO
NACOS_CACHE_DIR=./var/nacos/cache
NACOS_LOG_DIR=./var/nacos/log

# gRPC 超时，单位毫秒
NACOS_GRPC_TIMEOUT_MS=5000
